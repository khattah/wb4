/* GENERAL */
*,
*::before,
*::after {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: "Poppins", sans-serif;
    color: #333;
    line-height: 1.7;
}

img {
    display: block;
    max-width: 100%;
    height: auto;
}

h1,
h2,
h3,
h4,
h5,
h6,
p {
    margin: 0 0 16px;
}

h1,
h2,
h3,
h4 {
    line-height: 1.3;
}

button,
.app-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    max-width: 100%;
    padding: 12px 28px;
    border: 0;
    border-radius: 30px;
    font: inherit;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
}

a:focus-visible,
button:focus-visible {
    outline: 3px solid #222;
    outline-offset: 4px;
}

/* NAVBAR */
header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px max(20px, calc((100% - 1100px) / 2));
    background-color: #0084fd;
}

.logo,
.menu {
    flex-shrink: 0;
}

.logo img,
.menu img {
    width: 32px;
    height: 32px;
    object-fit: contain;
}

nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
}

nav a {
    color: white;
    text-decoration: none;
}

nav a:hover {
    text-decoration: underline;
}

/* SERVICES */
.services {
    max-width: 1140px;
    margin: 0 auto;
    padding: 60px 20px;
}

.services-row-one {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 24px;
    margin-bottom: 24px;
}

.services-row-two {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.demo-card,
.service-card {
    min-width: 0;
    border-radius: 24px;
}

.demo-card {
    display: flex;
    align-items: stretch;
    gap: 20px;
    padding: 30px 30px 0;
    background-color: #b5ddff;
}

.demo-text {
    flex: 1;
    min-width: 0;
    padding-bottom: 30px;
}

.demo-text h1 {
    color: #0084fd;
    font-size: 26px;
}

.demo-text p {
    margin-bottom: 24px;
}

.app-button {
    background-color: #0084fd;
    color: white;
}

.app-button img {
    width: 20px;
    height: 20px;
    object-fit: contain;
}

.phone {
    display: flex;
    align-items: flex-end;
    flex: 0 1 45%;
    min-width: 0;
}

.phone img {
    width: 100%;
}

.service-card {
    padding: 30px;
    text-align: center;
}

.service-card img {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    object-fit: contain;
}

.service-card h2 {
    font-size: 24px;
}

.service-card p {
    margin-bottom: 0;
}

.green {
    background-color: #c8ead8;
}

.pink {
    background-color: #f6c6d0;
}

.yellow {
    background-color: #ffe69b;
}

.purple {
    background-color: #d5c7f2;
}

/* STRATEGIC PLANNING */
.planning {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 60px;
    padding: 70px max(20px, calc((100% - 1100px) / 2));
    background-color: #9792e4;
}

.planning-image,
.planning-content {
    min-width: 0;
}

.planning-image img {
    width: 100%;
}

.planning-content > h2,
.planning-content > p {
    color: white;
}

.planning-content > h2 {
    font-size: 32px;
}

.app-development {
    margin-top: 30px;
    padding: 30px;
    border-radius: 30px;
    background-color: white;
    text-align: center;
}

.app-development img {
    width: 220px;
    margin: 0 auto 20px;
}

.app-development p {
    font-style: italic;
}

.app-development button {
    width: 50px;
    height: 50px;
    padding: 0;
    background-color: #9792e4;
    color: #222;
    font-size: 24px;
}

/* TESTIMONIALS */
.testimonials {
    max-width: 1140px;
    margin: 0 auto;
    padding: 70px 20px;
    text-align: center;
}

.small-title {
    letter-spacing: 2px;
}

.testimonials > h2 {
    color: #7974c7;
    font-size: clamp(28px, 4vw, 40px);
}

.intro {
    max-width: 750px;
    margin: 0 auto 35px;
}

.testimonial-card {
    display: flex;
    align-items: center;
    gap: 35px;
    margin-bottom: 24px;
    padding: 30px;
    border-radius: 30px;
    text-align: left;
}

.testimonial-card > div {
    min-width: 0;
}

.testimonial-card img {
    flex-shrink: 0;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
}

.testimonial-card h6 {
    font-size: 16px;
    font-weight: 400;
}

.testimonial-card h4 {
    margin-bottom: 0;
    letter-spacing: 1px;
}

.testimonial-pink {
    background-color: #f6c6d0;
}

.testimonial-yellow {
    background-color: #ffe69b;
}

.testimonial-green {
    background-color: #c8ead8;
}

/* BENEFITS */
.benefits {
    padding: 70px max(20px, calc((100% - 1100px) / 2));
    background-color: #9792e4;
}

.benefits > h2 {
    margin-bottom: 40px;
    color: white;
    font-size: clamp(28px, 4vw, 40px);
    text-align: center;
}

.benefit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.benefit-card {
    min-width: 0;
    padding: 30px;
    border-radius: 24px;
    background-color: white;
}

.benefit-card span {
    display: block;
    margin-bottom: 20px;
    color: #7974c7;
    font-size: 60px;
    font-weight: 700;
    line-height: 1.2;
}

.benefit-card h3 {
    color: #7974c7;
    font-size: 23px;
}

.benefit-card button,
.about-person button {
    background-color: #7974c7;
    color: white;
}

/* ABOUT US */
.about {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: start;
    gap: 60px;
    max-width: 1140px;
    margin: 0 auto;
    padding: 70px 20px;
}

.about-text,
.about-person {
    min-width: 0;
}

.about-text h2 {
    color: #7974c7;
    font-size: 48px;
}

.about-person {
    position: relative;
}

.about-person img {
    width: 180px;
    height: 180px;
    margin-bottom: 24px;
    border-radius: 50%;
    object-fit: cover;
}

.quote {
    position: absolute;
    top: -25px;
    left: 130px;
    color: #7974c7;
    font-size: 100px;
    line-height: 1;
}

.about-person h3 {
    color: #7974c7;
    font-size: 24px;
}

/* PRICING */
.pricing {
    padding: 60px 20px;
    background-color: #9792e4;
    color: white;
    text-align: center;
}

.pricing > p:first-child {
    letter-spacing: 3px;
}

.pricing h2 {
    font-size: clamp(26px, 4vw, 40px);
}

.pricing h1 {
    color: #ffda77;
    font-size: clamp(48px, 8vw, 80px);
    line-height: 1.2;
}

.pricing-text {
    max-width: 550px;
    margin: 0 auto 25px;
}

.pricing button {
    background-color: white;
    color: #7974c7;
}

.pricing small {
    display: block;
    margin-top: 30px;
}

/* FULL-WIDTH FOOTER */
.footer {
    width: 100%;
    padding: 25px 20px;
    background-color: #222;
    color: white;
    text-align: center;
}

.footer p {
    margin: 0 0 10px;
}

.footer a {
    display: inline-block;
    padding: 7px;
    border-radius: 4px;
}

.footer img {
    width: 30px;
    height: 30px;
    object-fit: contain;
}

/* TABLET */
@media (max-width: 900px) {
    .demo-card {
        flex-direction: column;
    }

    .phone {
        flex: 0 1 auto;
        width: 70%;
        align-self: center;
    }

    .planning,
    .about {
        gap: 30px;
    }

    .benefit-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* MOBILE */
@media (max-width: 600px) {
    header {
        flex-wrap: wrap;
        gap: 16px;
    }

    nav {
        order: 3;
        width: 100%;
        gap: 16px;
    }

    .services-row-one,
    .services-row-two,
    .planning,
    .benefit-grid,
    .about {
        grid-template-columns: 1fr;
    }

    .services,
    .testimonials,
    .about {
        padding: 40px 20px;
    }

    .planning,
    .benefits {
        padding: 40px 20px;
    }

    .phone {
        width: 80%;
    }

    .testimonial-card {
        flex-direction: column;
        gap: 20px;
        text-align: center;
    }

    .about-text h2 {
        font-size: 38px;
    }

    .about-person {
        margin-top: 20px;
    }
}
/* Paragraph text */
p {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
}

/* Testimonial text */
.testimonial-card h6 {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
}
.about-text p {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
}